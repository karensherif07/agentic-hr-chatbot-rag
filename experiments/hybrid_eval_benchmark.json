{
  "meta": {
    "purpose": "Hybrid answer generation evaluation — Horizon Tech HR Chatbot",
    "experiment": "Hybrid Query Evaluation",
    "total_queries": 80,
    "languages": ["english", "arabic_msa", "egyptian_arabic", "franco_arabic"],
    "queries_per_language": 20,
    "version": "1.0",
    "metrics": [
      "M1 — Tool Accuracy         : retrieve_policy AND correct DB tool(s) both called (rule-based)",
      "M2 — Policy Grounding      : answer contains [Page N | AR/EN] citation (rule-based) + policy fact correct (LLM judge)",
      "M3 — Personal Data Ground. : expected DB value present in answer (rule-based)"
    ],
    "hybrid_definition": "Question requires BOTH a policy rule AND this employee's personal data to answer fully",
    "design_notes": [
      "Queries are medium difficulty — they clearly need both policy and personal data",
      "Each query maps to one expected_db_tool (the planner should pick it) + retrieve_policy",
      "grounding_field: the personal DB field the answer must include",
      "policy_keyword: a word/phrase the answer must contain from policy context",
      "Topics: bonus eligibility, promotion, notice period, leave carry-over, gratuity,",
      "  savings plan, training budget, scholarship, work hours, health insurance add-ons"
    ]
  },

