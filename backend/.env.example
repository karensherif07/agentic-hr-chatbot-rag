# ── Database ───────────────────────────────────────────────────
DB_URL=postgresql+psycopg2://user:password@localhost:5432/horizon_hr

# ── Auth ───────────────────────────────────────────────────────
HR_AUTH_SECRET=change-me-to-a-long-random-string

# ── LLMs (Groq) ────────────────────────────────────────────────
GROQ_API_KEY=

# ── Speech-to-text (optional — falls back to local Whisper) ─────
DEEPGRAM_API_KEY=

# ── Escalation / Contact HR email ───────────────────────────────
HR_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Policy PDF storage directory ────────────────────────────────
POLICY_PDF_DIR=policies

# ── CORS — the frontend origin(s) allowed to call this API ─────
CORS_ORIGINS=http://localhost:5173
